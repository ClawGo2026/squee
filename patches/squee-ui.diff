+:root {
+  --stage: #f1e9df;
+  --panel: #f9faf7e8;
+  --line: #ffffffaa;
+  --ink: #4d564e;
+  --muted: #8d8779;
+  --round: 'SqueeRound', 'PingFang SC', 'HarmonyOS Sans SC', 'MiSans', system-ui, sans-serif;
+  font-family: var(--round);
+  font-synthesis: none;
+  font-size: 13px;
+  color: var(--ink);
+  color-scheme: light;
+  -webkit-tap-highlight-color: transparent;
 }
-@media(max-width:350px){.mobile-playbar button{column-gap:3px;grid-template-columns:24px auto}.mobile-playbar .play-icon{width:24px;height:24px}.mobile-playbar button strong{font-size:12px}.mobile-playbar button small{font-size:8px}}
+
+* { box-sizing: border-box; }
+
+html, body { height: 100%; margin: 0; overflow: hidden; overscroll-behavior: none; }
+
+body { background: var(--stage); }
+
+button { font: inherit; color: inherit; cursor: pointer; border: 0; background: none; padding: 0; }
+button:active { transform: translateY(1px); }
+[hidden] { display: none !important; }
+
+/* 舞台：占满整屏，手指拖动全部交给软体求解器 */
+#app { position: fixed; inset: 0; }
+#stage { position: absolute; inset: 0; }
+#scene { width: 100%; height: 100%; display: block; touch-action: none; cursor: grab; background: var(--stage); }
+#scene.grabbing { cursor: grabbing; }
+
+/* 竖屏 dock：文案贴顶、色板贴底，中间整块留给猫 */
+.dock {
+  position: absolute;
+  inset: 0;
+  z-index: 2;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: flex-start;
+  pointer-events: none;
+  padding: calc(env(safe-area-inset-top, 0px) + 16px) 16px calc(env(safe-area-inset-bottom, 0px) + 18px);
+}
+
+.caption {
+  margin: 0;
+  /* the line only has to clear the reset button, so only the right side is inset */
+  padding: 0 62px 0 0;
+  font-size: 24px;
+  line-height: 1.35;
+  letter-spacing: .04em;
+  color: var(--ink);
+  text-align: center;
+}
+
+/* 口味色板：汉字在下、颜色在上。margin-top:auto 把色板和复原按钮一起钉在屏幕底部。 */
+.flavors {
+  margin-top: auto;
+  display: flex;
+  gap: 2px;
+  padding: 10px 8px;
+  border: 1px solid var(--line);
+  border-radius: 28px;
+  background: var(--panel);
+  box-shadow: 0 12px 34px #4f554b12;
+  backdrop-filter: blur(18px);
+  pointer-events: auto;
+}
+
+.flavors button {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 6px;
+  width: 58px;
+  padding: 6px 0 4px;
+  border-radius: 22px;
+  transition: background .2s;
+}
+
+.flavors button:hover { background: #eef0ea80; }
+
+.flavors i {
+  display: block;
+  width: 24px;
+  height: 24px;
+  border-radius: 50%;
+  background: var(--dot, #bf9850);
+  box-shadow: inset 0 -7px 9px #00000024;
+  transition: box-shadow .2s;
+}
+
+.flavors span { font-size: 12px; color: var(--muted); transition: color .2s; }
+
+.flavors button[aria-pressed='true'] { background: #fff; }
+
+.flavors button[aria-pressed='true'] i {
+  box-shadow: inset 0 -7px 9px #00000024, 0 0 0 2px #fff, 0 0 0 4px var(--ink);
+}
+
+.flavors button[aria-pressed='true'] span { color: var(--ink); }
+
+/* 复原：猫头 + 「复原」两字，色板下方独占一行 */
+.reset {
+  margin-top: 10px;
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  height: 44px;
+  padding: 0 18px;
+  border: 1px solid var(--line);
+  border-radius: 999px;
+  background: var(--panel);
+  box-shadow: 0 10px 26px #4f554b12;
+  backdrop-filter: blur(18px);
+  font-size: 13px;
+  color: var(--ink);
+  pointer-events: auto;
+  transition: background .2s;
+}
+
+.reset:hover { background: #fdfcf8; }
+.reset svg { width: 22px; height: 22px; }
+
+/* 横屏：左栏放文字与色板，猫留在右栏 */
