index 35e0df2..635603a 100644
--- a/src/interaction/grab.ts
+++ b/src/interaction/grab.ts
@@ -1,41 +1,188 @@
 import { Raycaster,Vector2,Vector3,Plane,Triangle } from 'three/webgpu';
 import type { World } from '../scene/world.ts';
 import type { Simulation } from '../physics/simulation.ts';
+
+/** How long a tap keeps pressing before the grip lets go, in seconds. */
+const POKE_SECONDS=.16;
+/** How far a tap pushes the surface in, in world units — deep enough to see, shallow enough to keep volume. */
+const POKE_DEPTH=.2;
+/** Fraction of the way to the body axis that a full squeeze pulls the midpoint. */
+const PINCH_PULL=.5;
+/** A press that travels less than TAP_SLOP pixels and lasts under TAP_SECONDS counts as a tap. The window
+ * is generous because a deliberate tap is easily a third of a second on a phone. */
+const TAP_SLOP=6,TAP_SECONDS=.45;
+/** Height of the point every poke and squeeze aims at: the middle of the body. */
+const CORE_Y=.7;
+
+interface Contact {
+  id:number;
+  start:[number,number];
+  distance:number;
+  since:number;
+  /** Barycentric weights of the grabbed triangle, so a surviving finger can re-grab on its own. */
+  weights:[number,number][];
+  plane:Plane;
+  /** Where this finger is right now, tracked on its own drag plane. */
+  now:Vector3;
+}
+
 export function installGrab(canvas:HTMLCanvasElement,world:World,sim:Simulation) {
   const abort=new AbortController(),options={signal:abort.signal};
-  const ray=new Raycaster(),pointer=new Vector2(),plane=new Plane(),target=new Vector3();
-  let active:number|null=null,start:[number,number]=[0,0],distance=0,startPoint:Vector3|null=null;
-  const stats={starts:0,moves:0,releases:0,lastReleaseDistance:0,lastReleaseEnergy:0};
+  const ray=new Raycaster(),pointer=new Vector2();
+  const va=new Vector3(),vb=new Vector3(),vc=new Vector3(),bary=new Vector3();
+  const mid=new Vector3(),core=new Vector3(),pull=new Vector3();
+  const contacts=new Map<number,Contact>();
+  let drag:Contact|null=null;
+  let pinch:null|{a:Contact;b:Contact;span:number}=null;
+  let poke:null|{from:Vector3;delta:Vector3;age:number}=null;
+  let active:number|null=null;
+  const stats={starts:0,moves:0,releases:0,pokes:0,squeezes:0,lastReleaseDistance:0,lastReleaseEnergy:0};
+
   function rayAt(e:PointerEvent) {
-    const r=canvas.getBoundingClientRect();pointer.set((e.clientX-r.left)/r.width*2-1,-(e.clientY-r.top)/r.height*2+1);
+    const r=canvas.getBoundingClientRect();
+    pointer.set((e.clientX-r.left)/r.width*2-1,-(e.clientY-r.top)/r.height*2+1);
     ray.setFromCamera(pointer,world.camera);
   }
-  function cancel(){sim.body.release();if(active!==null&&canvas.hasPointerCapture(active))canvas.releasePointerCapture(active);active=null;canvas.classList.remove('grabbing');}
+  /** Moves a held finger along its drag plane and returns false when the ray runs parallel to it. */
+  function follow(c:Contact,e:PointerEvent):boolean {
+    c.distance=Math.max(c.distance,Math.hypot(e.clientX-c.start[0],e.clientY-c.start[1]));
+    rayAt(e);
+    return !!ray.ray.intersectPlane(c.plane,c.now);
+  }
+  /** Ray-casts the cat; returns a contact for the pressed patch, or null when the press misses. */
+  function contactFor(e:PointerEvent):Contact|null {
+    rayAt(e);
+    const hit=ray.intersectObject(world.pudding)[0];
+    if(!hit?.face)return null;
+    const {a,b,c}=hit.face,position=world.pudding.geometry.attributes.position;
+    const hitBary=Triangle.getBarycoord(hit.point,va.fromBufferAttribute(position,a),vb.fromBufferAttribute(position,b),vc.fromBufferAttribute(position,c),bary);
+    if(!hitBary)return null;
+    return {
+      id:e.pointerId,start:[e.clientX,e.clientY],distance:0,since:sim.time,
+      weights:world.skin.hitWeights([a,b,c],[hitBary.x,hitBary.y,hitBary.z]),
+      plane:new Plane().setFromNormalAndCoplanarPoint(world.camera.getWorldDirection(va),hit.point),
+      now:hit.point.clone(),
+    };
+  }
+  function drop(c:Contact) {
+    contacts.delete(c.id);
+    if(canvas.hasPointerCapture(c.id))canvas.releasePointerCapture(c.id);
+  }
+  function clear() {
+    for(const c of contacts.values())if(canvas.hasPointerCapture(c.id))canvas.releasePointerCapture(c.id);
+    contacts.clear();drag=null;pinch=null;poke=null;active=null;
+    sim.body.release();canvas.classList.remove('grabbing');
+  }
+
+  /* ── 捏一捏 ──────────────────────────────────────────────────────────
+   * Two fingers become a single grip spanning both patches. Its target is the midpoint between them,
+   * drawn towards the body axis in proportion to how much closer the fingers came than when they
+   * landed, so pushing your fingers together compresses the pudding instead of dragging it sideways.
+   * Lifting one finger hands the grip back to a plain one-finger drag rather than dropping the cat. */
+  function pinchTarget() {
+    if(!pinch)return;
+    const {a,b,span}=pinch;
+    mid.addVectors(a.now,b.now).multiplyScalar(.5);
+    const gap=Math.hypot(a.now.x-b.now.x,a.now.y-b.now.y,a.now.z-b.now.z);
+    if(span>.0001) {
+      const closed=Math.max(0,Math.min(1,(span-gap)/span));
+      core.set(0,CORE_Y,0);
+      pull.copy(core).sub(mid);
+      mid.addScaledVector(pull,closed*PINCH_PULL*Math.min(1,pull.length()));
+      if(closed>.05)stats.squeezes++;
+    }
+    sim.body.moveGrab([mid.x,mid.y,mid.z]);
+  }
+  function beginPinch(a:Contact,b:Contact) {
+    const weights:[number,number][]=[];
+    // One grip across both patches: each finger's share is halved so the pair reads as one squeeze.
+    for(const [id,w] of [...a.weights,...b.weights])weights.push([id,w*.5]);
+    sim.body.beginGrab(weights);
+    pinch={a,b,span:Math.hypot(a.now.x-b.now.x,a.now.y-b.now.y,a.now.z-b.now.z)};
+    drag=null;active=null;stats.starts++;
+    pinchTarget();
+  }
+
+  /* ── 戳一戳 ──────────────────────────────────────────────────────────
+   * A tap used to fire a small downward velocity impulse that the pudding swallowed whole. It is now
+   * a real press: the finger's own patch is gripped and pushed towards the middle of the body, held
+   * for a beat and then let go, so the dent springs back and wobbles like every other deformation. */
+  function startPoke(c:Contact) {
+    core.set(0,CORE_Y,0);
+    pull.copy(core).sub(c.now).normalize().multiplyScalar(POKE_DEPTH);
+    sim.body.beginGrab(c.weights);
+    poke={from:c.now.clone(),delta:pull.clone(),age:0};stats.pokes++;stats.starts++;
+  }
+
+  /**
+   * Called once per frame. The dent is eased in over the hold instead of arriving in a single jump:
+   * snapping the whole depth in one frame yanks the body hard enough to send the cat spinning, which
+   * reads as a glitch rather than a poke.
+   */
+  function update(dt:number) {
+    if(!poke)return;
+    poke.age+=dt;
+    const t=Math.min(1,poke.age/POKE_SECONDS),ease=t*t*(3-2*t);
+    sim.body.moveGrab([poke.from.x+poke.delta.x*ease,poke.from.y+poke.delta.y*ease,poke.from.z+poke.delta.z*ease]);
+    if(t>=1){sim.body.release();poke=null;}
+  }
+
+  /**
+   * Lifts one finger. A pinch hands the grip back to whichever finger is still down, so adding or
+   * removing a finger mid-squeeze never drops the cat; the last finger up either pokes or lets go.
+   */
+  function release(c:Contact,tapped:boolean) {
+    stats.releases++;stats.lastReleaseDistance=c.distance;stats.lastReleaseEnergy=sim.body.metrics().energy;
+    const wasDrag=drag===c,wasPinch=!!pinch&&(pinch.a===c||pinch.b===c);
