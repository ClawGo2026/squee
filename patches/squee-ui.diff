diff --git a/preview/eyes.html b/preview/eyes.html
new file mode 100644
index 0000000..c0e4d16
--- /dev/null
+++ b/preview/eyes.html
@@ -0,0 +1,212 @@
+<!doctype html>
+<html lang="zh-CN">
+<head>
+<meta charset="utf-8" />
+<title>深色口味 · 眼睛配色预览</title>
+<style>
+  body{margin:0;background:#f1e9df;font:14px/1.6 -apple-system,"PingFang SC","Microsoft YaHei",sans-serif;color:#4d564e}
+  h1{font-size:18px;margin:24px 24px 4px}
+  p.note{margin:0 24px 18px;color:#8d8779;font-size:12px}
+  .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;padding:0 24px 28px}
+#zoom{display:grid;grid-template-columns:repeat(6,1fr);gap:10px;padding:0 24px 8px}
+#zoom .z{background:#141418;border-radius:14px;padding:8px 6px 6px;text-align:center;min-width:0}
+#zoom canvas{display:block;width:100%;height:auto}
+#zoom b{display:block;color:#f3ead9;font-size:12px;margin-top:4px}
+#zoom span{display:block;color:#8d8779;font-size:10px}
+  .card{background:#f9faf7;border:1px solid #ffffffaa;border-radius:18px;overflow:hidden;box-shadow:0 10px 30px #4f554b12}
+  .card canvas{display:block;width:100%;height:auto}
+  .cap{padding:10px 12px 14px}
+  .cap b{display:block;font-size:13px;margin-bottom:2px}
+  .cap span{font-size:11px;color:#8d8779}
+</style>
+</head>
+<body>
+<h1>深色口味 · 眼睛配色预览</h1>
+<p class="note">左边一列是浅色口位的对照组；每个卡片与游戏里用的是同一套猫脸绘制参数（u/v 坐标、瞳仁与高光的相对位置）。</p>
+<h2 style="font-size:14px;margin:0 24px 8px">瞳孔方案 · 放大对比</h2>
+<div id="zoom"></div>
+<h2 style="font-size:14px;margin:18px 24px 8px">整体效果（游戏内同款脸型）</h2>
+<div class="grid" id="grid"></div>
+
+<script>
+/* Mirrors src/scene/world.ts: the same face is painted into a 2048x1024 canvas and mapped onto the
+   pudding skin. Only the eye treatment varies here, so the options can be compared side by side. */
+const FLAVORS={
+  vanilla:{label:'牛奶',body:'#fff1dc',top:'#d7a15f',eye:'#493021',mouth:'#71503b',blush:'#e9aa87'},
+  cocoa:{label:'黑金',body:'#191920',top:'#f2c14e',eye:'#1a1208',rim:'#f2c14e',mouth:'#d9b56a',blush:'#c9962f'},
+  cyber:{label:'赛博',body:'#4a0f6b',top:'#ff2fb9',eye:'#1a1208',rim:'#ff2fb9',mouth:'#ffc9f2',blush:'#ff2fb9'},
+};
+const STYLES={
+  current:{label:'现状',hint:'浅瞳仁 + 深高光'},
+  rim:{label:'A 描边眼（已采用）',hint:'深瞳仁 + 口味色描边 + 白高光'},
+  amber:{label:'B 琥珀眼',hint:'暖琥珀瞳仁 + 白高光'},
+  neon:{label:'C 霓虹眼',hint:'高饱和虹膜 + 白高光'},
+  soft:{label:'D 柔灰眼',hint:'中性浅灰蓝 + 白高光'},
+  depth:{label:'E 渐深眼',hint:'上浅下深的虹膜 + 白高光'},
+  small:{label:'F 小瞳孔',hint:'浅瞳仁缩小 + 深高光'},
+};
+
+function luminance(hex){const n=parseInt(hex.slice(1),16);return (((n>>16)&255)*.299+((n>>8)&255)*.587+(n&255)*.114)/255;}
+function drawPudding(pen,f,style,W,H){
+  // A rounded pudding body, close enough to the in-game silhouette to judge the face against it.
+  const cx=W*.5,top=H*.30,bot=H*.94,halfTop=W*.30,halfBot=W*.40;
+  // ears
+  for(const sgn of [-1,1]){
+    pen.beginPath();
+    pen.moveTo(cx+sgn*halfTop*.62,top+H*.02);
+    pen.lineTo(cx+sgn*halfTop*.70,top-H*.14);
+    pen.lineTo(cx+sgn*halfTop*.14,top-H*.02);
+    pen.closePath();pen.fillStyle=f.body;pen.fill();
+  }
+  // body: rounded trapezoid
+  pen.beginPath();
+  pen.moveTo(cx-halfTop,top);
+  pen.lineTo(cx+halfTop,top);
+  pen.quadraticCurveTo(cx+halfBot,top+(bot-top)*.62,cx+halfBot*.62,bot-H*.06);
+  pen.quadraticCurveTo(cx,bot+H*.02,cx-halfBot*.62,bot-H*.06);
+  pen.quadraticCurveTo(cx-halfBot,top+(bot-top)*.62,cx-halfTop,top);
+  pen.closePath();pen.fillStyle=f.body;pen.fill();
+  // glaze cap
+  pen.save();pen.clip();
+  pen.fillStyle=f.top;
+  pen.fillRect(cx-halfTop,top,halfTop*2,(bot-top)*.22);
+  pen.restore();
+  // soft shading so it reads like the real render
+  const g=pen.createLinearGradient(cx-halfBot,0,cx+halfBot,0);
+  g.addColorStop(0,'#ffffff10');g.addColorStop(.35,'#ffffff00');g.addColorStop(1,'#00000022');
+  pen.fillStyle=g;pen.fillRect(0,0,W,H);
+  drawFace(pen,f,style,W,H);
+}
+
+function drawFace(pen,f,style,W,H){
+  // face UV -> preview pixels (the real shader maps u around the body, v bottom-to-top)
+  const ux=u=>W*(.5+(u-.5)*.78), vy=v=>H*(.52+v*.22);
+  const rx=W*.026,ry=H*.075;
+  const light=luminance(f.eye)>.62;
+  const darkSpark='#241a10',white='#fffdf6';
+  for(const u of [.428,.572]){
+    const x=ux(u),y=vy(.72);
+    if(style==='current'||style==='small'){
+      const scale=style==='small'?.82:1;
+      pen.fillStyle=f.eye;pen.beginPath();pen.ellipse(x,y,rx*scale,ry*scale,0,0,7);pen.fill();
+      pen.fillStyle=light?darkSpark:white;pen.beginPath();pen.ellipse(x-rx*.28,y-ry*.36,rx*.22,ry*.3,0,0,7);pen.fill();
+    }else if(style==='rim'){
+      pen.fillStyle=f.top;pen.beginPath();pen.ellipse(x,y,rx*1.18,ry*1.12,0,0,7);pen.fill();
+      pen.fillStyle='#1a1208';pen.beginPath();pen.ellipse(x,y,rx*.92,ry*.9,0,0,7);pen.fill();
+      pen.fillStyle=white;pen.beginPath();pen.ellipse(x-rx*.3,y-ry*.34,rx*.2,ry*.28,0,0,7);pen.fill();
+    }else if(style==='amber'){
+      const g=pen.createRadialGradient(x-rx*.3,y-ry*.3,rx*.1,x,y,rx*1.2);
+      g.addColorStop(0,'#f0c479');g.addColorStop(.55,'#c4873a');g.addColorStop(1,'#7a4d18');
+      pen.fillStyle=g;pen.beginPath();pen.ellipse(x,y,rx,ry,0,0,7);pen.fill();
+      pen.fillStyle=white;pen.beginPath();pen.ellipse(x-rx*.3,y-ry*.36,rx*.2,ry*.26,0,0,7);pen.fill();
+    }else if(style==='neon'){
+      const neon=f.label==='赛博'?'#2ee6ff':'#ffd166';
+      const g=pen.createRadialGradient(x,y,rx*.15,x,y,rx*1.15);
+      g.addColorStop(0,neon);g.addColorStop(.6,f.top);g.addColorStop(1,'#1a0b26');
+      pen.fillStyle=g;pen.beginPath();pen.ellipse(x,y,rx,ry,0,0,7);pen.fill();
+      pen.fillStyle=white;pen.beginPath();pen.ellipse(x-rx*.3,y-ry*.34,rx*.2,ry*.26,0,0,7);pen.fill();
+    }else if(style==='soft'){
+      const g=pen.createRadialGradient(x-rx*.25,y-ry*.25,rx*.1,x,y,rx*1.1);
+      g.addColorStop(0,'#dfe6ee');g.addColorStop(.6,'#9aa7b8');g.addColorStop(1,'#4a5464');
+      pen.fillStyle=g;pen.beginPath();pen.ellipse(x,y,rx,ry,0,0,7);pen.fill();
+      pen.fillStyle=white;pen.beginPath();pen.ellipse(x-rx*.3,y-ry*.34,rx*.2,ry*.26,0,0,7);pen.fill();
+    }else if(style==='depth'){
+      const g=pen.createLinearGradient(x,y-ry,x,y+ry);
+      g.addColorStop(0,'#6b5a42');g.addColorStop(.45,f.eye);g.addColorStop(1,'#2a2018');
+      pen.fillStyle=g;pen.beginPath();pen.ellipse(x,y,rx,ry,0,0,7);pen.fill();
+      pen.fillStyle=white;pen.beginPath();pen.ellipse(x-rx*.3,y-ry*.36,rx*.2,ry*.26,0,0,7);pen.fill();
+    }
+  }
+  // mouth + blush
+  pen.strokeStyle=f.mouth;pen.lineWidth=W*.012;pen.lineCap='round';
+  pen.beginPath();
+  const mx=W*.5,my=vy(.18);
+  pen.moveTo(mx-W*.05,my);pen.quadraticCurveTo(mx-W*.025,my+W*.03,mx,my+W*.004);
+  pen.quadraticCurveTo(mx+W*.025,my+W*.03,mx+W*.05,my);pen.stroke();
+  for(const u of [.394,.606]){
+    const x=ux(u),y=vy(.36);
+    const g=pen.createRadialGradient(x,y,0,x,y,W*.05);
+    g.addColorStop(0,f.blush+'55');g.addColorStop(1,f.blush+'00');
+    pen.fillStyle=g;pen.beginPath();pen.arc(x,y,W*.05,0,7);pen.fill();
+  }
+}
+
+// 只画一双眼睛的放大对照：背景用对应口味的深色身体色
+const zoom=document.getElementById('zoom');
+for(const fid of ['cocoa','cyber']){
+  for(const sid of Object.keys(STYLES)){
+    if(sid==='current')continue;
+    const f=FLAVORS[fid],s2=STYLES[sid];
+    const box=document.createElement('div');box.className='z';
+    const c=document.createElement('canvas');c.width=300;c.height=240;
+    const pen=c.getContext('2d');
+    pen.fillStyle=f.body;pen.fillRect(0,0,c.width,c.height);
+    const g=pen.createLinearGradient(0,0,c.width,c.height);g.addColorStop(0,'#ffffff10');g.addColorStop(1,'#00000030');
+    pen.fillStyle=g;pen.fillRect(0,0,c.width,c.height);
+    // 放大的眼睛（沿用 drawFace 的绘制分支，只改尺寸）
+    const big={...f};
+    drawFaceBig(pen,big,sid,c.width,c.height);
+    box.append(c);
+    const cap=document.createElement('div');
+    cap.innerHTML=`<b>${f.label} · ${s2.label}</b><span>${s2.hint}</span>`;
+    box.append(cap);zoom.append(box);
+  }
+}
+function drawFaceBig(pen,f,style,W,H){
+  const rx=W*.13,ry=H*.30,cx=W*.5,cy=H*.48;
+  const light=luminance(f.eye)>.62,darkSpark='#241a10',white='#fffdf6';
+  for(const sgn of [-1,1]){
+    const x=cx+sgn*rx*1.5;
+    if(style==='current'||style==='small'){
+      const sc=style==='small'?.82:1;
+      pen.fillStyle=f.eye;pen.beginPath();pen.ellipse(x,cy,rx*sc,ry*sc,0,0,7);pen.fill();
+      pen.fillStyle=light?darkSpark:white;pen.beginPath();pen.ellipse(x-rx*.28,cy-ry*.36,rx*.2,ry*.3,0,0,7);pen.fill();
+    }else if(style==='rim'){
+      pen.fillStyle=f.top;pen.beginPath();pen.ellipse(x,cy,rx*1.18,ry*1.1,0,0,7);pen.fill();
+      pen.fillStyle='#1a1208';pen.beginPath();pen.ellipse(x,cy,rx*.9,ry*.88,0,0,7);pen.fill();
+      pen.fillStyle=white;pen.beginPath();pen.ellipse(x-rx*.3,cy-ry*.34,rx*.2,ry*.28,0,0,7);pen.fill();
+    }else if(style==='amber'){
+      const g=pen.createRadialGradient(x-rx*.3,cy-ry*.3,rx*.1,x,cy,rx*1.2);
+      g.addColorStop(0,'#f0c479');g.addColorStop(.55,'#c4873a');g.addColorStop(1,'#7a4d18');
+      pen.fillStyle=g;pen.beginPath();pen.ellipse(x,cy,rx,ry,0,0,7);pen.fill();
+      pen.fillStyle=white;pen.beginPath();pen.ellipse(x-rx*.3,cy-ry*.36,rx*.2,ry*.26,0,0,7);pen.fill();
+    }else if(style==='neon'){
+      const neon=f.label==='赛博'?'#2ee6ff':'#ffd166';
+      const g=pen.createRadialGradient(x,cy,rx*.15,x,cy,rx*1.15);
+      g.addColorStop(0,neon);g.addColorStop(.6,f.top);g.addColorStop(1,'#1a0b26');
+      pen.fillStyle=g;pen.beginPath();pen.ellipse(x,cy,rx,ry,0,0,7);pen.fill();
+      pen.fillStyle=white;pen.beginPath();pen.ellipse(x-rx*.3,cy-ry*.34,rx*.2,ry*.26,0,0,7);pen.fill();
+    }else if(style==='soft'){
+      const g=pen.createRadialGradient(x-rx*.25,cy-ry*.25,rx*.1,x,cy,rx*1.1);
+      g.addColorStop(0,'#dfe6ee');g.addColorStop(.6,'#9aa7b8');g.addColorStop(1,'#4a5464');
+      pen.fillStyle=g;pen.beginPath();pen.ellipse(x,cy,rx,ry,0,0,7);pen.fill();
+      pen.fillStyle=white;pen.beginPath();pen.ellipse(x-rx*.3,cy-ry*.34,rx*.2,ry*.26,0,0,7);pen.fill();
+    }else if(style==='depth'){
+      const g=pen.createLinearGradient(x,cy-ry,x,cy+ry);
+      g.addColorStop(0,'#6b5a42');g.addColorStop(.45,f.eye);g.addColorStop(1,'#2a2018');
+      pen.fillStyle=g;pen.beginPath();pen.ellipse(x,cy,rx,ry,0,0,7);pen.fill();
+      pen.fillStyle=white;pen.beginPath();pen.ellipse(x-rx*.3,cy-ry*.36,rx*.2,ry*.26,0,0,7);pen.fill();
+    }
+  }
+}
+
+const grid=document.getElementById('grid');
+const order=[...Object.keys(FLAVORS)];
+for(const fid of order){
+  for(const sid of Object.keys(STYLES)){
+    if(fid==='vanilla'&&sid!=='current')continue;
+    const f=FLAVORS[fid],s=STYLES[sid];
+    const card=document.createElement('div');card.className='card';
+    const c=document.createElement('canvas');c.width=560;c.height=470;
+    const pen=c.getContext('2d');
+    pen.fillStyle='#f1e9df';pen.fillRect(0,0,c.width,c.height);
+    drawPudding(pen,f,sid,c.width,c.height);
+    card.append(c);
+    const cap=document.createElement('div');cap.className='cap';
+    cap.innerHTML=`<b>${f.label} · ${s.label}</b><span>${s.hint}</span>`;
+    card.append(cap);grid.append(card);
+  }
+}
+</script>
+</body>
+</html>
