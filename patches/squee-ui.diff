+  // Everything addressed in the cat's own frame (glaze band, face decal, camera heading) relies on this.
+  const mesh=makeVolumeMesh(),{rest,n}=mesh,ca=Math.cos(CAT_YAW),sa=Math.sin(CAT_YAW);
