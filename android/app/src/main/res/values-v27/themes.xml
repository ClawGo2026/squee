<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 8.0 (API 27) is where drawing into the display cutout became possible. -->
    <style name="Theme.Squee" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/stage</item>
        <item name="android:colorBackground">@color/stage</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
